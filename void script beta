local Animator = {}
Animator.__index = Animator

local animators = {}
local loopConnection = nil

local function stepAnimators(dt)
    dt = math.min(dt, 1 / 30)
    local dead = nil

    for a in pairs(animators) do
        if not a.Object or not a.Object.Parent then
            dead = dead or {}
            dead[#dead + 1] = a
            continue
        end
        if not a.Active then
            continue
        end

        local moving = false
        local springs = a.Springs

        for i = 1, #springs do
            local s = springs[i]
            local diff = s.Target - s.Value
            if math.abs(diff) > 0.00005 or math.abs(s.Velocity) > 0.00005 then
                local accel = diff * a.Stiffness - s.Velocity * a.Damping
                s.Velocity = s.Velocity + accel * dt
                s.Value = s.Value + s.Velocity * dt
                moving = true
            else
                s.Value = s.Target
                s.Velocity = 0
            end
        end

        a:Write()

        if not moving then
            a.Active = false
        end
    end

    if dead then
        for _, a in ipairs(dead) do
            animators[a] = nil
        end
    end
end

function Animator.new(object, property, stiffness, damping, clampMin)
    local self = setmetatable({}, Animator)
    self.Object = object
    self.Property = property
    self.Stiffness = stiffness or 340
    self.Damping = damping or 22
    self.ClampMin = clampMin
    self.Active = false

    local value = object[property]
    local kind = typeof(value)
    self.Kind = kind

    if kind == "number" then
        self.Springs = { { Value = value, Target = value, Velocity = 0 } }
    elseif kind == "Color3" then
        self.Springs = {
            { Value = value.R, Target = value.R, Velocity = 0 },
            { Value = value.G, Target = value.G, Velocity = 0 },
            { Value = value.B, Target = value.B, Velocity = 0 },
        }
    elseif kind == "UDim2" then
        self.Springs = {
            { Value = value.X.Scale, Target = value.X.Scale, Velocity = 0 },
            { Value = value.X.Offset, Target = value.X.Offset, Velocity = 0 },
            { Value = value.Y.Scale, Target = value.Y.Scale, Velocity = 0 },
            { Value = value.Y.Offset, Target = value.Y.Offset, Velocity = 0 },
        }
    else
        self.Springs = { { Value = 0, Target = 0, Velocity = 0 } }
    end

    if not loopConnection then
        loopConnection = RunService.Heartbeat:Connect(stepAnimators)
    end

    animators[self] = true
    return self
end

function Animator:Write()
    local s = self.Springs

    if self.Kind == "number" then
        local v = s[1].Value
        if self.ClampMin and v < self.ClampMin then
            v = self.ClampMin
        end
        self.Object[self.Property] = v
    elseif self.Kind == "Color3" then
        self.Object[self.Property] = Color3.new(s[1].Value, s[2].Value, s[3].Value)
    elseif self.Kind == "UDim2" then
        self.Object[self.Property] = UDim2.new(s[1].Value, s[2].Value, s[3].Value, s[4].Value)
    end
end

function Animator:Set(target)
    local s = self.Springs

    if self.Kind == "number" then
        s[1].Target = target
    elseif self.Kind == "Color3" then
        s[1].Target = target.R
        s[2].Target = target.G
        s[3].Target = target.B
    elseif self.Kind == "UDim2" then
        s[1].Target = target.X.Scale
        s[2].Target = target.X.Offset
        s[3].Target = target.Y.Scale
        s[4].Target = target.Y.Offset
    end

    self.Active = true
end

function Animator:Snap(target)
    self:Set(target)
    local s = self.Springs
    for i = 1, #s do
        s[i].Value = s[i].Target
        s[i].Velocity = 0
    end
    self:Write()
    self.Active = false
end

local function createUICorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = parent
    return corner
end

local function createUIStroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Theme.Stroke
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function createBall(parent, size, colorA, colorB)
    local ball = Instance.new("Frame")
    ball.Size = UDim2.fromOffset(size, size)
    ball.AnchorPoint = Vector2.new(0.5, 0.5)
    ball.BackgroundColor3 = colorA
    ball.BorderSizePixel = 0
    ball.ZIndex = 200
    ball.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = ball

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new(colorA, colorB)
    gradient.Rotation = 45
    gradient.Parent = ball

    local stroke = Instance.new("UIStroke")
    stroke.Color = colorB
    stroke.Thickness = 1.5
    stroke.Transparency = 0.45
    stroke.Parent = ball

    return ball, gradient
end

local function flyBalls(parent, origin, target, duration, onDone)
    local ballA, gradA = createBall(parent, 24, Theme.Accent, Theme.AccentSoft)
    local ballB, gradB = createBall(parent, 15, Theme.AccentSoft, Theme.Accent)

    local baseA, baseB = 24, 15
    local elapsed = 0
    local conn

    conn = RunService.Heartbeat:Connect(function(dt)
        if not ballA.Parent or not ballB.Parent then
            conn:Disconnect()
            return
        end

        elapsed = elapsed + dt
        local raw = math.clamp(elapsed / duration, 0, 1)
        local t = 1 - (1 - raw) ^ 3

        local cx = origin.X + (target.X - origin.X) * t
        local cy = origin.Y + (target.Y - origin.Y) * t

        local envelope = math.sin(raw * math.pi)
        local amp = 54 * envelope

        local spin = raw * math.pi * 2.8
        local ax = math.cos(spin) * amp
        local ay = math.sin(spin) * amp * 0.55

        ballA.Position = UDim2.fromOffset(cx + ax, cy + ay)
        ballB.Position = UDim2.fromOffset(cx - ax, cy - ay)

        gradA.Rotation = 45 + raw * 540
        gradB.Rotation = 45 - raw * 540

        local shrink = 1
        if raw > 0.82 then
            shrink = 1 - (raw - 0.82) / 0.18
        end
        shrink = math.max(shrink, 0.01)

        ballA.Size = UDim2.fromOffset(baseA * shrink, baseA * shrink)
        ballB.Size = UDim2.fromOffset(baseB * shrink, baseB * shrink)

        if raw >= 1 then
            conn:Disconnect()
            ballA:Destroy()
            ballB:Destroy()
            if onDone then
                onDone()
            end
        end
    end)
end

local function spawnBurst(parent, center, count)
    local rng = Random.new()
    local palette = { Theme.Accent, Theme.AccentSoft, Theme.Text }
    local parts = {}

    for i = 1, count do
        local size = rng:NextNumber(3, 9)
        local p = Instance.new("Frame")
        p.AnchorPoint = Vector2.new(0.5, 0.5)
        p.Size = UDim2.fromOffset(size, size)
        p.Position = UDim2.fromOffset(center.X, center.Y)
        p.BackgroundColor3 = palette[rng:NextInteger(1, #palette)]
        p.BorderSizePixel = 0
        p.ZIndex = 320
        p.Parent = parent

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = p

        local angle = rng:NextNumber(0, math.pi * 2)
        local speed = rng:NextNumber(160, 520)

        parts[#parts + 1] = {
            obj = p,
            vx = math.cos(angle) * speed,
            vy = math.sin(angle) * speed,
            age = 0,
            life = rng:NextNumber(0.45, 0.8),
            base = size,
        }
    end

    local conn

    conn = RunService.Heartbeat:Connect(function(dt)
        local alive = false

        for i = 1, #parts do
            local d = parts[i]
            if d.obj.Parent and d.age < d.life then
                alive = true
                d.age = d.age + dt
                d.vy = d.vy + 820 * dt
                d.vx = d.vx * (1 - 2.2 * dt)
                d.vy = d.vy * (1 - 0.6 * dt)

                local px = d.obj.Position.X.Offset + d.vx * dt
                local py = d.obj.Position.Y.Offset + d.vy * dt
                d.obj.Position = UDim2.fromOffset(px, py)

                local t = d.age / d.life
                d.obj.BackgroundTransparency = math.clamp(t * 1.2, 0, 1)

                local s = d.base * (1 - 0.8 * t)
                d.obj.Size = UDim2.fromOffset(s, s)

                if d.age >= d.life then
                    d.obj:Destroy()
                end
            end
        end

        if not alive then
            conn:Disconnect()
        end
    end)
end

